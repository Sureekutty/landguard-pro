# LandGuard Pro - Production Environment Configuration Template
# Copy this file to .env and configure values before starting the application.
# NEVER commit the actual .env file with production secrets.

# Application Server Port
PORT=8080

# PostgreSQL Production Database Configuration
# Examples:
# Local/Docker: jdbc:postgresql://localhost:5432/landguard_db
# Cloud Supabase: jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
# Cloud Neon: jdbc:postgresql://ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/landguard_db
SPRING_DATASOURCE_USERNAME=landguard_admin
SPRING_DATASOURCE_PASSWORD=YourStrongDatabasePasswordHere123!
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver

# Security & JWT Configuration
# Generate a secure 256-bit+ random secret: openssl rand -hex 64
JWT_SECRET=generate_and_replace_with_a_cryptographically_secure_random_64_char_hex_key
JWT_EXPIRATION_MS=86400000

# Administrator Bootstrap (First-time auto-creation)
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=ChooseAStrongProductionAdminPassword2026!

# Cross-Origin Resource Sharing (CORS) Allowlist (comma-separated URLs)
CORS_ALLOWED_ORIGINS=https://sureekutty.github.io,http://localhost:8080,http://127.0.0.1:8080
