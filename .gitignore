# LandGuard Pro - Repository Safety & Privacy Rules
# Blocks sensitive land documents, image uploads, keys, and environment variables

# Personal & Land Documents
*.pdf
*.PDF
*.jpg
*.jpeg
*.png
*.PNG
*.JPG
*.webp
*.tiff
uploads/
scans/
documents/
*.doc
*.docx

# Environment & Secrets
.env
.env.*
!.env.example
!**/.env.example
*.key
*.pem
*.cert
*.crt
*.pfx
*.p12
id_rsa*
secrets/

# Database & Backups
*.sqlite
*.sqlite3
*.db
*.bak
*.backup
*.dump
export/
*.export
*.tar.gz
*.zip

# Logs & Runtime
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
node_modules/
.DS_Store
Thumbs.db

# Maven & Java Build Outputs
target/
**/target/
*.class
.mvn/.extracted/
.classpath
.project
.settings/
.idea/
*.iml

# Test temporary files
.tmp-chrome-profile*
